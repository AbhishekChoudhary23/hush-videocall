# --- Server (read by index.js) ---
PORT=3000
# Comma-separated origins allowed to open a signaling connection.
# Not needed when the server itself serves Client/dist (same origin).
CLIENT_ORIGIN=http://localhost:5173
MAX_ROOM_SIZE=4
# Concurrent connections allowed per IP address. 0 disables the limit.
MAX_CONN_PER_IP=30
# Set to 1 when running behind a reverse proxy (Render, Nginx, ...), otherwise
# every visitor appears to come from the proxy's address and shares one limit.
TRUST_PROXY=0

# --- Client (build time, put in Client/.env) ---
# Only needed when the signaling server is on a different origin.
# VITE_SERVER_URL=https://signal.example.com
# STUN/TURN servers as JSON. Add a TURN server for people behind strict firewalls.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]

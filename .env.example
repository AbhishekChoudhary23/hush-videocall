# --- Server (read by index.js) ---
PORT=3000
# Comma-separated origins allowed to open a signaling connection.
# Not needed when the server itself serves Client/dist (same origin).
CLIENT_ORIGIN=http://localhost:5173
MAX_ROOM_SIZE=4
# Concurrent connections allowed per IP address. 0 disables the limit.
MAX_CONN_PER_IP=30
# Set to 1 when running behind a reverse proxy (Render, Nginx, ...), otherwise
# every visitor appears to come from the proxy's address and shares one limit.
TRUST_PROXY=0

# --- TURN relay (strongly recommended) ---
# Without TURN, calls fail when either person is behind carrier-grade NAT
# (most mobile data, many home ISPs). Set ONE of the options below on the
# server; browsers get short-lived credentials from /api/ice.
# Option 1: Cloudflare Realtime TURN (dash.cloudflare.com > Realtime > TURN)
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
# Option 2: Metered (metered.ca) - your app domain and API key
# METERED_DOMAIN=yourapp.metered.live
# METERED_API_KEY=
# Option 3: fixed list as JSON
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# --- Client (build time, put in Client/.env) ---
# Only needed when the signaling server is on a different origin.
# VITE_SERVER_URL=https://signal.example.com
# Fixed STUN/TURN list baked into the client. Overrides /api/ice; prefer the server options above.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
